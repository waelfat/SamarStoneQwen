<!-- Views/MarbleTypes/Create.cshtml -->
@model MarbleType
@{
    ViewData["Title"] = "Create Marble Type";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-gem me-2"></i>Create Marble Type</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-gem me-2"></i>Marble Type Information</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Name" class="form-label"><i class="fas fa-gem me-1"></i>Type Name</label>
                                <input asp-for="Name" class="form-control" placeholder="Enter marble type name (e.g., Carrara White)" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Color" class="form-label"><i class="fas fa-palette me-1"></i>Color</label>
                                <input asp-for="Color" class="form-control" placeholder="Enter color (e.g., White, Beige, Gray)" />
                                <span asp-validation-for="Color" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="OriginCountry" class="form-label"><i class="fas fa-flag me-1"></i>Origin Country</label>
                                <input asp-for="OriginCountry" class="form-control" placeholder="Enter country of origin (e.g., Italy, Spain, Turkey)" />
                                <span asp-validation-for="OriginCountry" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="QualityGrade" class="form-label"><i class="fas fa-star me-1"></i>Quality Grade</label>
                                <select asp-for="QualityGrade" class="form-control" required>
                                    <option value="">-- Select Quality --</option>
                                    <option value="A">A - Premium Quality</option>
                                    <option value="B">B - Good Quality</option>
                                    <option value="C">C - Standard Quality</option>
                                </select>
                                <span asp-validation-for="QualityGrade" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="DefaultCostPerSqM" class="form-label"><i class="fas fa-dollar-sign me-1"></i>Default Cost per SqM (USD)</label>
                                <input asp-for="DefaultCostPerSqM" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                                <span asp-validation-for="DefaultCostPerSqM" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <div class="form-check mt-4">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked>
                                    <label asp-for="IsActive" class="form-check-label">Active Type</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label"><i class="fas fa-info-circle me-1"></i>Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the marble type characteristics"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Create Marble Type
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-info-circle me-2"></i>Help</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    <i class="fas fa-lightbulb me-2 text-warning"></i>
                    Define marble types with default costs and quality grades. These will be used when importing slabs.
                </p>
                <div class="alert alert-info">
                    <h6><i class="fas fa-check-circle me-2"></i>Important Notes</h6>
                    <ul class="mb-0">
                        <li>Type name is required</li>
                        <li>Default cost is used for initial pricing</li>
                        <li>Quality grade affects classification</li>
                        <li>Active types can be selected for slabs</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}