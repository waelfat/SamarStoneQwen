<!-- Views/MarbleTypes/Index.cshtml -->
@model IEnumerable<MarbleType>
@{
    ViewData["Title"] = "Marble Types";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-gem me-2"></i>Marble Types</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <div class="btn-group me-2">
            <a asp-action="Create" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-plus-circle me-1"></i> New Type
            </a>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" class="form-control" placeholder="Search marble types..." id="searchInput">
        </div>
    </div>
    <div class="col-md-6 text-end">
        <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                <i class="fas fa-filter me-1"></i> Filter by Status
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#" onclick="filterByStatus('')">All</a></li>
                <li><a class="dropdown-item" href="#" onclick="filterByStatus('true')">Active</a></li>
                <li><a class="dropdown-item" href="#" onclick="filterByStatus('false')">Inactive</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover" id="marbleTypesTable">
        <thead class="table-dark">
            <tr>
                <th><i class="fas fa-gem me-1"></i>Name</th>
                <th><i class="fas fa-palette me-1"></i>Color</th>
                <th><i class="fas fa-flag me-1"></i>Origin</th>
                <th><i class="fas fa-balance-scale me-1"></i>Quality</th>
                <th><i class="fas fa-dollar-sign me-1"></i>Default Cost</th>
                <th><i class="fas fa-th-large me-1"></i>Slab Count</th>
                <th><i class="fas fa-toggle-on me-1"></i>Status</th>
                <th><i class="fas fa-cogs me-1"></i>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-status="@(item.IsActive.ToString().ToLower())">
                    <td><i class="fas fa-gem text-info me-2"></i> <strong>@item.Name</strong></td>
                    <td><i class="fas fa-palette me-1" style="color: @item.Color.ToLower();"></i> @item.Color</td>
                    <td><i class="fas fa-flag text-primary me-1"></i> @item.OriginCountry</td>
                    <td><span class="badge bg-info">@item.QualityGrade</span></td>
                    <td><i class="fas fa-dollar-sign text-success me-1"></i> $@item.DefaultCostPerSqM.ToString("N2")</td>
                    <td><span class="badge bg-info">@item.Slabs.Count()</span></td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                            <i class="fas @(item.IsActive ? "fa-check-circle" : "fa-times-circle") me-1"></i>
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Details">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Deactivate">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.getElementById('searchInput').addEventListener('keyup', function() {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('#marbleTypesTable tbody tr');
        
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(searchTerm) ? '' : 'none';
        });
    });

    function filterByStatus(status) {
        const rows = document.querySelectorAll('#marbleTypesTable tbody tr');
        
        rows.forEach(row => {
            if (status === '') {
                row.style.display = '';
            } else {
                const rowStatus = row.getAttribute('data-status');
                row.style.display = rowStatus === status ? '' : 'none';
            }
        });
    }
</script>