<!-- Views/UserManagement/Edit.cshtml -->
@model EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-user-edit me-2"></i>Edit User</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-user me-2"></i>User Information</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Username" class="form-label"><i class="fas fa-user me-1"></i>Username</label>
                                <input asp-for="Username" class="form-control" placeholder="Enter username" required />
                                <span asp-validation-for="Username" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Email" class="form-label"><i class="fas fa-envelope me-1"></i>Email</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" required />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="FirstName" class="form-label"><i class="fas fa-signature me-1"></i>First Name</label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="LastName" class="form-label"><i class="fas fa-signature me-1"></i>Last Name</label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Role" class="form-label"><i class="fas fa-user-tag me-1"></i>User Role</label>
                                <select asp-for="Role" class="form-control" required>
                                    <option value="Employee">Employee</option>
                                    <option value="Admin">Admin</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="MustChangePassword" class="form-label"><i class="fas fa-key me-1"></i>Password Policy</label>
                                <select asp-for="MustChangePassword" class="form-control" required>
                                    <option value="true">User must change password</option>
                                    <option value="false">User can keep current password</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox">
                                    <label asp-for="IsActive" class="form-check-label">Active User</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Update User
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-info-circle me-2"></i>User Information</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <strong>User ID:</strong> <code>@Model.Id.Substring(0, 8)...</code>
                </div>
                <div class="mb-3">
                    <strong>Username:</strong> @Model.Username
                </div>
                <div class="mb-3">
                    <strong>Email:</strong> @Model.Email
                </div>
                <div class="mb-3">
                    <strong>Current Role:</strong> 
                    <span class="badge bg-info">@Model.Role</span>
                </div>
                <div class="mb-3">
                    <strong>Status:</strong> 
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
                <div class="alert alert-info">
                    <h6><i class="fas fa-user-clock me-2"></i>Actions</h6>
                    <div class="d-grid gap-2">
                        <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="btn btn-warning btn-sm" onclick="return confirm('Are you sure you want to reset the password for this user? The password will be set to Password123! and the user will be required to change it on next login.')">
                            <i class="fas fa-key me-1"></i> Reset Password
                        </a>
                        <a asp-action="ToggleActivation" asp-route-id="@Model.Id" class="btn btn-@(Model.IsActive ? "danger" : "success") btn-sm" onclick="return confirm(@(Model.IsActive ? "'Are you sure you want to deactivate this user?'" : "'Are you sure you want to activate this user?'"))">
                            <i class="fas @(Model.IsActive ? "fa-user-slash" : "fa-user-check") me-1"></i>
                            @(Model.IsActive ? "Deactivate" : "Activate")
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set the selected value for the role dropdown based on the model value
        document.addEventListener('DOMContentLoaded', function() {
            const roleSelect = document.querySelector('select[name="Role"]');
            if (roleSelect) {
                roleSelect.value = '@Model.Role';
            }
            
            const passwordPolicySelect = document.querySelector('select[name="MustChangePassword"]');
            if (passwordPolicySelect) {
                passwordPolicySelect.value = @Model.MustChangePassword.ToString().ToLower();
            }
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}