<!-- Views/Slabs/Index.cshtml (Updated) -->
@model IEnumerable<Slab>
@{
    ViewData["Title"] = "Slabs";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-th-large me-2"></i>Slabs</h1>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" class="form-control" placeholder="Search slabs..." id="searchInput">
        </div>
    </div>
    <div class="col-md-6 text-end">
        <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                <i class="fas fa-filter me-1"></i> Filter by Status
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#" onclick="filterByStatus('')">All</a></li>
                <li><a class="dropdown-item" href="#" onclick="filterByStatus('Available')">Available</a></li>
                <li><a class="dropdown-item" href="#" onclick="filterByStatus('Sold')">Sold</a></li>
                <li><a class="dropdown-item" href="#" onclick="filterByStatus('Reserved')">Reserved</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover" id="slabsTable">
        <thead class="table-dark">
            <tr>
                <th><i class="fas fa-hashtag me-1"></i>Slab #</th>
                <th><i class="fas fa-gem me-1"></i>Type</th>
                <th><i class="fas fa-ruler-combined me-1"></i>Dimensions</th>
                <th><i class="fas fa-ruler me-1"></i>Area (sqm)</th>
                <th><i class="fas fa-balance-scale me-1"></i>Quality</th>
                <th><i class="fas fa-flag me-1"></i>Origin</th>
                <th><i class="fas fa-tag me-1"></i>Status</th>
                <th><i class="fas fa-box me-1"></i>Container</th>
                <th><i class="fas fa-cogs me-1"></i>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-status="@item.Status.ToLower()">
                    <td><i class="fas fa-hashtag text-primary me-2"></i> @item.SlabNumber</td>
                    <td><i class="fas fa-gem text-info me-2"></i> @item.MarbleTypeNavigation.Name</td>
                    <td><i class="fas fa-ruler-combined text-muted me-1"></i> @item.Width × @item.Length × @item.Thickness cm</td>
                    <td><i class="fas fa-ruler text-success me-1"></i> @item.Area.ToString("N4")</td>
                    <td><span class="badge bg-info">@item.MarbleTypeNavigation.QualityGrade</span></td>
                    <td><i class="fas fa-flag text-primary me-1"></i> @item.MarbleTypeNavigation.OriginCountry</td>
                    <td>
                        <span class="badge @(item.Status == "Available" ? "bg-success" : 
                              item.Status == "Sold" ? "bg-danger" : "bg-warning")">
                            <i class="fas @(item.Status == "Available" ? "fa-check-circle" : 
                                  item.Status == "Sold" ? "fa-times-circle" : "fa-clock") me-1"></i>
                            @item.Status
                        </span>
                    </td>
                    <td><i class="fas fa-box text-secondary me-2"></i> @item.Container.ContainerNumber</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Details">
                                <i class="fas fa-eye"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.getElementById('searchInput').addEventListener('keyup', function() {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('#slabsTable tbody tr');
        
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(searchTerm) ? '' : 'none';
        });
    });

    function filterByStatus(status) {
        const rows = document.querySelectorAll('#slabsTable tbody tr');
        
        rows.forEach(row => {
            if (status === '') {
                row.style.display = '';
            } else {
                const rowStatus = row.getAttribute('data-status');
                row.style.display = rowStatus === status.toLowerCase() ? '' : 'none';
            }
        });
    }
</script>