<!-- Views/PurchaseOrders/Details.cshtml (Fixed AntiForgeryToken) -->
@model PurchaseOrder
@{
    ViewData["Title"] = "Purchase Order Details";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-file-invoice me-2"></i>Purchase Order Details</h1>
</div>

<!-- Anti-forgery token -->
@Html.AntiForgeryToken()

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-info-circle me-2"></i>Order Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-4"><strong>Order Number:</strong></div>
                    <div class="col-sm-8"><code>@Model.OrderNumber</code></div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Supplier:</strong></div>
                    <div class="col-sm-8">@Model.Supplier.Name</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Contact Person:</strong></div>
                    <div class="col-sm-8">@Model.Supplier.ContactPerson</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Order Date:</strong></div>
                    <div class="col-sm-8">@Model.OrderDate.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Expected Delivery:</strong></div>
                    <div class="col-sm-8">@Model.ExpectedDeliveryDate.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Status:</strong></div>
                    <div class="col-sm-8">
                        <span class="badge @(Model.Status == "Paid" || Model.Status == "Delivered" ? "bg-success" : 
                              Model.Status == "PartiallyPaid" ? "bg-warning" : "bg-info")">
                            <i class="fas @(Model.Status == "Paid" || Model.Status == "Delivered" ? "fa-check-circle" : 
                                  Model.Status == "PartiallyPaid" ? "fa-clock" : "fa-hourglass-half") me-1"></i>
                            @Model.Status
                        </span>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Notes:</strong></div>
                    <div class="col-sm-8">@Model.Notes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-calculator me-2"></i>Financial Summary</h5>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <div class="d-flex justify-content-between">
                        <span>Total Amount:</span>
                        <strong>$(@Model.TotalAmountUSD.ToString("N2"))</strong>
                    </div>
                </div>
                <div class="mb-2">
                    <div class="d-flex justify-content-between">
                        <span>Paid Amount:</span>
                        <strong>$@Model.PaidAmountUSD.ToString("N2")</strong>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <span>Remaining:</span>
                        <strong class="text-danger">$@((Model.TotalAmountUSD - Model.PaidAmountUSD).ToString("N2"))</strong>
                    </div>
                </div>
                <div class="progress mb-2" style="height: 10px;">
                    @{
                        var paymentPercentage = Model.TotalAmountUSD > 0 ? (Model.PaidAmountUSD / Model.TotalAmountUSD * 100) : 0;
                    }
                    <div class="progress-bar" role="progressbar" 
                         style="width: @(paymentPercentage.ToString("N2"))%" 
                         aria-valuenow="@(paymentPercentage)" 
                         aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
                <small class="text-muted">Payment Progress</small>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-boxes me-2"></i>Containers</h5>
    </div>
    <div class="card-body">
        @if (Model.Containers.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Container #</th>
                            <th>Size (ft)</th>
                            <th>Weight (tons)</th>
                            <th>Status</th>
                            <th>Arrival Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var container in Model.Containers)
                        {
                            <tr>
                                <td>@container.ContainerNumber</td>
                                <td>@container.SizeInFeet ft</td>
                                <td>@container.WeightInTons tons</td>
                                <td>
                                    <span class="badge @(container.Status == "Delivered" || container.Status == "Unloaded" ? "bg-success" : 
                                          container.Status == "Arrived" ? "bg-warning" : "bg-info")">
                                        @container.Status
                                    </span>
                                </td>
                                <td>
                                    @if (container.ArrivalDate.HasValue)
                                    {
                                        @container.ArrivalDate.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Containers" asp-action="Details" asp-route-id="@container.Id" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center">
                <i class="fas fa-box-open fa-3x text-muted mb-2"></i>
                <p class="text-muted">No containers associated with this purchase order.</p>
                <a asp-controller="Containers" asp-action="Create"  asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i> Add Container
                </a>
            </div>
        }
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-credit-card me-2"></i>Payment Form</h5>
    </div>
    <div class="card-body">
        <form id="paymentForm">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label for="paymentDate" class="form-label"><i class="fas fa-calendar me-1"></i>Payment Date</label>
                        <input type="date" class="form-control" id="paymentDate" required />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label for="amountUSD" class="form-label"><i class="fas fa-dollar-sign me-1"></i>Amount (USD)</label>
                        <input type="number" step="0.01" class="form-control" id="amountUSD" placeholder="0.00" required />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label for="paymentMethod" class="form-label"><i class="fas fa-credit-card me-1"></i>Payment Method</label>
                        <select class="form-control" id="paymentMethod" required>
                            <option value="">-- Select Method --</option>
                            <option value="MoneyTransfer">Money Transfer</option>
                            <option value="BankWire">Bank Wire</option>
                            <option value="Cash">Cash</option>
                            <option value="Check">Check</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label for="transactionReference" class="form-label"><i class="fas fa-hashtag me-1"></i>Transaction Reference</label>
                        <input type="text" class="form-control" id="transactionReference" placeholder="Enter transaction reference" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label for="description" class="form-label"><i class="fas fa-sticky-note me-1"></i>Description</label>
                        <input type="text" class="form-control" id="description" placeholder="Enter payment description" />
                    </div>
                </div>
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-success" id="addPaymentBtn">
                    <i class="fas fa-plus me-1"></i> Add Payment
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-receipt me-2"></i>Payment History</h5>
    </div>
    <div class="card-body">
        @if (Model.Payments.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Amount (USD)</th>
                            <th>Method</th>
                            <th>Transaction Ref</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="paymentsTableBody">
                        @foreach (var payment in Model.Payments)
                        {
                            <tr id="payment-row-@payment.Id">
                                <td>@payment.PaymentDate.ToString("dd/MM/yyyy")</td>
                                <td>$@payment.AmountUSD.ToString("N2")</td>
                                <td>@payment.PaymentMethod</td>
                                <td>@payment.TransactionReference</td>
                                <td>@payment.Description</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-danger" title="Delete" onclick="deletePayment('@payment.Id')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center" id="noPaymentsMessage">
                <i class="fas fa-money-bill-wave fa-3x text-muted mb-2"></i>
                <p class="text-muted">No payments recorded for this purchase order.</p>
            </div>
        }
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-tasks me-2"></i>Actions</h5>
    </div>
    <div class="card-body">
        <div class="d-grid gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit me-1"></i> Edit Purchase Order
            </a>
            <a asp-controller="Containers" asp-action="Create"  asp-route-id="@Model.Id" class="btn btn-info">
                <i class="fas fa-box me-1"></i> Add Container
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>
<script>
    const purchaseOrderId = '@Model.Id';
    const totalAmount = @Model.TotalAmountUSD;
    const currentPaidAmount = @Model.PaidAmountUSD;

    document.addEventListener('DOMContentLoaded', function() {
        // Set default payment date to today
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('paymentDate').value = today;
        
        // Generate transaction reference
        const timestamp = new Date().toISOString().replace(/[-:]/g, '').substring(0, 14);
        document.getElementById('transactionReference').value = 'MT-' + timestamp;

        // Add payment button click handler
        document.getElementById('addPaymentBtn').addEventListener('click', addPayment);
    });

    async function addPayment() {
        const paymentDate = document.getElementById('paymentDate').value;
        const amountUSD = parseFloat(document.getElementById('amountUSD').value);
        const paymentMethod = document.getElementById('paymentMethod').value;
        const transactionReference = document.getElementById('transactionReference').value;
        const description = document.getElementById('description').value;

        if (!paymentDate || !amountUSD || !paymentMethod) {
            alert('Please fill in all required fields.');
            return;
        }

        // Check if payment amount is valid
        const remainingAmount = totalAmount - currentPaidAmount;
        if (isNaN(amountUSD) || amountUSD > remainingAmount) {
            alert(`Payment amount exceeds remaining balance. Maximum allowed: $${remainingAmount.toFixed(2)}`);
            return;
        }

        const paymentData = {
            purchaseOrderId: purchaseOrderId,
            paymentDate: paymentDate,
            amountUSD: amountUSD,
            paymentMethod: paymentMethod,
            transactionReference: transactionReference,
            description: description
        };

        try {
            // Get the anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch('/PurchaseOrders/AddPayment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(paymentData)
            });

            // Check for HTTP errors
            if (!response.ok) {
                const errorResult = await response.json().catch(() => ({ message: 'Unknown error' }));
                throw new Error(errorResult.message || `HTTP error! status: ${response.status}`);
            }

            const result = await response.json();
            
            if (result.success) {
                // Show success message
                showNotification('Payment added successfully!', 'success');
                
                // Reload the page to update all data
                setTimeout(() => {
                    location.reload();
                }, 1000); // Wait a bit for the notification to show
            } else {
                showNotification(result.message || 'Error adding payment.', 'error');
            }
        } catch (error) {
            console.error('Error:', error);
            showNotification('Error adding payment: ' + error.message, 'error');
        }
    }

    async function deletePayment(paymentId) {
        if (!confirm('Are you sure you want to delete this payment?')) {
            return;
        }

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch(`/PurchaseOrders/DeletePayment/${paymentId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }
            });

            if (!response.ok) {
                const errorResult = await response.json().catch(() => ({ message: 'Unknown error' }));
                throw new Error(errorResult.message || `HTTP error! status: ${response.status}`);
            }

            const result = await response.json();
            
            if (result.success) {
                showNotification('Payment deleted successfully!', 'success');
                
                // Reload the page to update all data
                setTimeout(() => {
                    location.reload();
                }, 1000); // Wait a bit for the notification to show
            } else {
                showNotification(result.message || 'Error deleting payment.', 'error');
            }
        } catch (error) {
            console.error('Error:', error);
            showNotification('Error deleting payment: ' + error.message, 'error');
        }
    }

    function showNotification(message, type) {
        // Create notification element
        const notification = document.createElement('div');
        notification.className = `alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible fade show position-fixed`;
        notification.style.zIndex = '9999';
        notification.style.top = '20px';
        notification.style.right = '20px';
        notification.style.minWidth = '300px';
        notification.innerHTML = `
            <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle'} me-2"></i>
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        `;
        
        document.body.appendChild(notification);
        
        // Remove notification after 5 seconds
        setTimeout(() => {
            if (notification.parentNode) {
                notification.remove();
            }
        }, 5000);
    }
</script>
@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
}