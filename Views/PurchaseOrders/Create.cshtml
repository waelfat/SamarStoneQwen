<!-- Updated Views/PurchaseOrders/Create.cshtml -->
@model PurchaseOrder
@{
    ViewData["Title"] = "Create Purchase Order";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-file-invoice me-2"></i>Create Purchase Order</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-file-invoice me-2"></i>Purchase Order Details</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="SupplierId" class="form-label"><i class="fas fa-building me-1"></i>Supplier</label>
                                <select asp-for="SupplierId" class="form-control" asp-items="@(new SelectList(ViewBag.Suppliers, "Id", "Name"))" required>
                                    <option value="">-- Select Supplier --</option>
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="OrderDate" class="form-label"><i class="fas fa-calendar me-1"></i>Order Date</label>
                                <input asp-for="OrderDate" type="date" class="form-control" required />
                                <span asp-validation-for="OrderDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="TotalAmountUSD" class="form-label"><i class="fas fa-dollar-sign me-1"></i>Total Amount (USD)</label>
                                <input asp-for="TotalAmountUSD" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                                <span asp-validation-for="TotalAmountUSD" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="PaidAmountUSD" class="form-label"><i class="fas fa-credit-card me-1"></i>Paid Amount (USD)</label>
                                <input asp-for="PaidAmountUSD" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                <span asp-validation-for="PaidAmountUSD" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ExpectedDeliveryDate" class="form-label"><i class="fas fa-truck me-1"></i>Expected Delivery Date</label>
                                <input asp-for="ExpectedDeliveryDate" type="date" class="form-control" required />
                                <span asp-validation-for="ExpectedDeliveryDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Currency" class="form-label"><i class="fas fa-coins me-1"></i>Currency</label>
                                <select asp-for="Currency" class="form-control" required>
                                    <option value="USD">USD - US Dollar</option>
                                </select>
                                <span asp-validation-for="Currency" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Status" class="form-label"><i class="fas fa-flag me-1"></i>Status</label>
                        <select asp-for="Status" class="form-control" required>
                            <option value="Pending">Pending</option>
                            <option value="PartiallyPaid">Partially Paid</option>
                            <option value="Paid">Paid</option>
                            <option value="Delivered">Delivered</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Notes" class="form-label"><i class="fas fa-sticky-note me-1"></i>Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Additional notes about the purchase order"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Create Purchase Order
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-info-circle me-2"></i>Help</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    <i class="fas fa-lightbulb me-2 text-warning"></i>
                    Select a supplier and enter the order details. The system will track payments and delivery status.
                </p>
                <div class="alert alert-info">
                    <h6><i class="fas fa-calculator me-2"></i>Financial Summary</h6>
                    <p class="mb-1">Remaining Amount: <strong id="remainingAmount">$0.00</strong></p>
                    <p class="mb-0">Payment Status: <strong id="paymentStatus">Pending</strong></p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const totalInput = document.getElementById('TotalAmountUSD');
        const paidInput = document.getElementById('PaidAmountUSD');
        
        function updateFinancialSummary() {
            const total = parseFloat(totalInput.value) || 0;
            const paid = parseFloat(paidInput.value) || 0;
            const remaining = total - paid;
            
            document.getElementById('remainingAmount').textContent = '$' + remaining.toFixed(2);
            
            let status = 'Pending';
            if (paid === 0) status = 'Pending';
            else if (paid < total) status = 'Partially Paid';
            else if (paid >= total) status = 'Fully Paid';
            
            document.getElementById('paymentStatus').textContent = status;
        }
        
        totalInput.addEventListener('input', updateFinancialSummary);
        paidInput.addEventListener('input', updateFinancialSummary);
        
        // Initial calculation
        updateFinancialSummary();
    });
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}