<!-- Views/PurchaseOrders/Index.cshtml -->
@model IEnumerable<PurchaseOrder>
@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-file-invoice me-2"></i>Purchase Orders</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <div class="btn-group me-2">
            <a asp-action="Create" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-plus-circle me-1"></i> New Order
            </a>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th><i class="fas fa-building me-1"></i>Supplier</th>
                <th><i class="fas fa-calendar me-1"></i>Order Date</th>
                <th><i class="fas fa-dollar-sign me-1"></i>Total (USD)</th>
                <th><i class="fas fa-dollar-sign me-1"></i>Paid (USD)</th>
                <th><i class="fas fa-dollar-sign me-1"></i>Remaining (USD)</th>
                <th><i class="fas fa-flag me-1"></i>Status</th>
                <th><i class="fas fa-truck me-1"></i>Expected Delivery</th>
                <th><i class="fas fa-cogs me-1"></i>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><i class="fas fa-building me-2 text-primary"></i> @item.Supplier.Name</td>
                    <td><i class="fas fa-calendar text-muted me-1"></i> @item.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td><i class="fas fa-dollar-sign text-success me-1"></i> $@item.TotalAmountUSD.ToString("N2")</td>
                    <td><i class="fas fa-dollar-sign text-info me-1"></i> $@item.PaidAmountUSD.ToString("N2")</td>
                    <td><i class="fas fa-dollar-sign text-warning me-1"></i> $@item.RemainingAmountUSD.ToString("N2")</td>
                    <td>
                        <span class="badge @(item.Status == "Paid" || item.Status == "Delivered" ? "bg-success" : 
                              item.Status == "PartiallyPaid" ? "bg-warning" : "bg-secondary")">
                            <i class="fas @(item.Status == "Paid" || item.Status == "Delivered" ? "fa-check-circle" : 
                                  item.Status == "PartiallyPaid" ? "fa-clock" : "fa-hourglass-half") me-1"></i>
                            @item.Status
                        </span>
                    </td>
                    <td><i class="fas fa-truck text-muted me-1"></i> @item.ExpectedDeliveryDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Details">
                                <i class="fas fa-eye"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>