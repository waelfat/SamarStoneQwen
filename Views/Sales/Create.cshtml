<!-- Views/Sales/Create.cshtml (Improved with SaleItemViewModel) -->
@model CreateSaleViewModel
@{
    ViewData["Title"] = "Create Sale";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-tag me-2"></i>Create Sale</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-shopping-cart me-2"></i>Sale Information</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" id="saleForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="CustomerId" class="form-label"><i class="fas fa-user me-1"></i>Customer</label>
                                <select asp-for="CustomerId" class="form-control" asp-items="@(new SelectList(Model.AvailableCustomers, "Id", "Name"))" required>
                                    <option value="">-- Select Customer --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6><i class="fas fa-list me-2"></i>Sale Items</h6>
                        </div>
                        <div class="card-body">
                            <div id="saleItems">
                                @for (int i = 0; i < Model.SaleItems.Count; i++)
                                {
                                    <div class="sale-item mb-3 p-3 border rounded bg-light">
                                        <input type="hidden" name="SaleItems.Index" value="@i" />
                                        
                                        <div class="row">
                                            <div class="col-md-3">
                                                <label class="form-label">Marble Type</label>
                                                <select name="SaleItems[@i].MarbleTypeId" class="form-control marble-type-select" required>
                                                    <option value="">-- Select Type --</option>
                                                    @foreach (var type in Model.AvailableMarbleTypes)
                                                    {
                                                        <option value="@type.Id" selected="@(Model.SaleItems[i].MarbleTypeId == type.Id)">@(type.Name)</option>
                                                    }
                                                </select>
                                                <span class="text-danger field-validation-valid" data-valmsg-for="SaleItems[@i].MarbleTypeId" data-valmsg-replace="true"></span>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Width (cm)</label>
                                                <input type="number" name="SaleItems[@i].Width" class="form-control dimension-input" step="0.1" min="0" placeholder="120" value="@(Model.SaleItems[i].Width)" required />
                                                <span class="text-danger field-validation-valid" data-valmsg-for="SaleItems[@i].Width" data-valmsg-replace="true"></span>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Length (cm)</label>
                                                <input type="number" name="SaleItems[@i].Length" class="form-control dimension-input" step="0.1" min="0" placeholder="240" value="@(Model.SaleItems[i].Length)" required />
                                                <span class="text-danger field-validation-valid" data-valmsg-for="SaleItems[@i].Length" data-valmsg-replace="true"></span>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Thickness (cm)</label>
                                                <input type="number" name="SaleItems[@i].Thickness" class="form-control dimension-input" step="0.1" min="0" placeholder="2.0" value="@(Model.SaleItems[i].Thickness)" required />
                                                <span class="text-danger field-validation-valid" data-valmsg-for="SaleItems[@i].Thickness" data-valmsg-replace="true"></span>
                                            </div>
                                            <div class="col-md-1">
                                                <label class="form-label">Quantity</label>
                                                <input type="number" name="SaleItems[@i].Quantity" class="form-control quantity-input" step="1" min="1" placeholder="1" value="@(Model.SaleItems[i].Quantity)" required />
                                                <span class="text-danger field-validation-valid" data-valmsg-for="SaleItems[@i].Quantity" data-valmsg-replace="true"></span>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Unit Price (EGP)</label>
                                                <input type="number" name="SaleItems[@i].UnitPrice" class="form-control price-input" step="0.01" min="0" placeholder="5000" value="@(Model.SaleItems[i].UnitPrice)" required />
                                                <span class="text-danger field-validation-valid" data-valmsg-for="SaleItems[@i].UnitPrice" data-valmsg-replace="true"></span>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-md-12">
                                                <button type="button" class="btn btn-sm btn-outline-danger remove-item" title="Remove Item">
                                                    <i class="fas fa-trash me-1"></i> Remove
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="add-item">
                                <i class="fas fa-plus me-1"></i>Add Another Item
                            </button>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6><i class="fas fa-receipt me-2"></i>Sale Summary</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">Total Items:</label>
                                        <input type="text" class="form-control" id="total-items" readonly value="@(Model.SaleItems.Count)">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">Total Price (EGP):</label>
                                        <input type="text" class="form-control" id="total-price" readonly value="0.00">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-success" id="submit-btn">
                            <i class="fas fa-save me-1"></i> Create Sale
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-info-circle me-2"></i>Instructions</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    <i class="fas fa-lightbulb me-2 text-warning"></i>
                    Select marble type and minimum dimensions needed. The system will automatically select the best available slabs using FIFO principle.
                </p>
                <p class="text-muted">
                    <i class="fas fa-box me-2 text-success"></i>
                    Available marble types: <strong>@Model.AvailableMarbleTypes.Count()</strong>
                </p>
                <p class="text-muted">
                    <i class="fas fa-sort-amount-up me-2 text-info"></i>
                    FIFO (First In, First Out) ensures oldest inventory is allocated first.
                </p>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header">
                <h5><i class="fas fa-chart-bar me-2"></i>How It Works</h5>
            </div>
            <div class="card-body">
                <ol class="text-muted">
                    <li>Select customer from the list</li>
                    <li>Specify marble type and exact dimensions</li>
                    <li>Specify quantity needed</li>
                    <li>System finds best matching slabs</li>
                    <li>FIFO principle ensures efficient allocation</li>
                    <li>Submit to create the sale</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<style>
    .sale-item {
        background-color: #f8f9fa;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const addItemBtn = document.getElementById('add-item');
        const saleItemsContainer = document.getElementById('saleItems');
        let itemIndex = @Model.SaleItems.Count;

        // Function to update summary
        function updateSummary() {
            let totalItems = 0;
            let totalPrice = 0;
            
            document.querySelectorAll('.sale-item').forEach(item => {
                const quantityInput = item.querySelector('.quantity-input');
                const unitPriceInput = item.querySelector('.price-input');
                
                if (quantityInput && unitPriceInput) {
                    const quantity = parseInt(quantityInput.value) || 0;
                    const unitPrice = parseFloat(unitPriceInput.value) || 0;
                    const itemTotal = quantity * unitPrice;
                    
                    totalPrice += itemTotal;
                    totalItems++;
                }
            });
            
            document.getElementById('total-items').value = totalItems;
            document.getElementById('total-price').value = totalPrice.toFixed(2);
        }
        
        // Add item functionality
        addItemBtn.addEventListener('click', function() {
            const newItem = document.createElement('div');
            newItem.className = 'sale-item mb-3 p-3 border rounded bg-light';
            newItem.innerHTML = `
                <input type="hidden" name="SaleItems.Index" value="\${itemIndex}" />
                
                <div class="row">
                    <div class="col-md-3">
                        <label class="form-label">Marble Type</label>
                        <select name="SaleItems[\${itemIndex}].MarbleTypeId" class="form-control marble-type-select" required>
                            <option value="">-- Select Type --</option>
                            @foreach (var type in Model.AvailableMarbleTypes)
                            {
                                <option value="@type.Id">@type.Name</option>
                            }
                        </select>
                        <span class="text-danger field-validation-valid" data-valmsg-for="SaleItems[\${itemIndex}].MarbleTypeId" data-valmsg-replace="true"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Width (cm)</label>
                        <input type="number" name="SaleItems[\${itemIndex}].Width" class="form-control dimension-input" step="0.1" min="0" placeholder="120" required />
                        <span class="text-danger field-validation-valid" data-valmsg-for="SaleItems[\${itemIndex}].Width" data-valmsg-replace="true"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Length (cm)</label>
                        <input type="number" name="SaleItems[\${itemIndex}].Length" class="form-control dimension-input" step="0.1" min="0" placeholder="240" required />
                        <span class="text-danger field-validation-valid" data-valmsg-for="SaleItems[\${itemIndex}].Length" data-valmsg-replace="true"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Thickness (cm)</label>
                        <input type="number" name="SaleItems[\${itemIndex}].Thickness" class="form-control dimension-input" step="0.1" min="0" placeholder="2.0" required />
                        <span class="text-danger field-validation-valid" data-valmsg-for="SaleItems[\${itemIndex}].Thickness" data-valmsg-replace="true"></span>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Quantity</label>
                        <input type="number" name="SaleItems[\${itemIndex}].Quantity" class="form-control quantity-input" step="1" min="1" placeholder="1" required />
                        <span class="text-danger field-validation-valid" data-valmsg-for="SaleItems[\${itemIndex}].Quantity" data-valmsg-replace="true"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Unit Price (EGP)</label>
                        <input type="number" name="SaleItems[\${itemIndex}].UnitPrice" class="form-control price-input" step="0.01" min="0" placeholder="5000" required />
                        <span class="text-danger field-validation-valid" data-valmsg-for="SaleItems[\${itemIndex}].UnitPrice" data-valmsg-replace="true"></span>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-sm btn-outline-danger remove-item" title="Remove Item">
                            <i class="fas fa-trash me-1"></i> Remove
                        </button>
                    </div>
                </div>
            `;
            saleItemsContainer.appendChild(newItem);
            itemIndex++;
            updateSummary();
        });
        
        // Event delegation for remove item
        saleItemsContainer.addEventListener('click', function(e) {
            if (e.target.closest('.remove-item')) {
                const item = e.target.closest('.sale-item');
                if (saleItemsContainer.children.length > 1) {
                    item.remove();
                    updateSummary();
                } else {
                    alert('At least one item must remain.');
                }
            }
        });
        
        // Event delegation for input changes to update summary
        saleItemsContainer.addEventListener('input', function(e) {
            if (e.target.classList.contains('quantity-input') || 
                e.target.classList.contains('price-input')) {
                updateSummary();
            }
        });
        
        // Form submission handling
        document.getElementById('saleForm').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submit-btn');
            
            // Show processing state
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Processing...';
        });
        
        // Initialize summary
        updateSummary();
    });
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}