<!-- Views/Sales/Details.cshtml (Updated with ViewModel) -->
@model SaleDetailsViewModel
@{
    ViewData["Title"] = "Sale Details";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-receipt me-2"></i>Sale Details</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-info-circle me-2"></i>Sale Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-4"><strong>Sale ID:</strong></div>
                    <div class="col-sm-8"><code>@Model.Id.Substring(0, 8)...</code></div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Customer:</strong></div>
                    <div class="col-sm-8">@Model.CustomerName</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Sale Date:</strong></div>
                    <div class="col-sm-8">@Model.SaleDate.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Created Date:</strong></div>
                    <div class="col-sm-8">@Model.CreatedDate.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Notes:</strong></div>
                    <div class="col-sm-8">@Model.Notes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-calculator me-2"></i>Financial Summary</h5>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <div class="d-flex justify-content-between">
                        <span>Total Revenue:</span>
                        <strong class="text-success">EGP @Model.TotalRevenue.ToString("N2")</strong>
                    </div>
                </div>
                <div class="mb-2">
                    <div class="d-flex justify-content-between">
                        <span>Total Cost:</span>
                        <strong class="text-danger">EGP @Model.TotalCost.ToString("N2")</strong>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <span>Total Profit:</span>
                        <strong class="text-success">EGP @Model.TotalProfit.ToString("N2")</strong>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <span>Profit Margin:</span>
                        <strong class="@(Model.ProfitMargin >= 20 ? "text-success" : Model.ProfitMargin >= 10 ? "text-info" : "text-warning")">
                            @Model.ProfitMargin.ToString("N2")%
                        </strong>
                    </div>
                </div>
                
                <div class="progress mb-2" style="height: 10px;">
                    <div class="progress-bar bg-success" role="progressbar" 
                         style="width: @(Math.Abs(Model.ProfitMargin).ToString("N2"))%" 
                         aria-valuenow="@(Math.Abs(Model.ProfitMargin))" 
                         aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
                <small class="text-muted">Profit Margin Progress</small>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-list me-2"></i>Sale Items</h5>
    </div>
    <div class="card-body">
        @if (Model.SaleItems.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Slab #</th>
                            <th>Marble Type</th>
                            <th>Dimensions</th>
                            <th>Area Sold (sqm)</th>
                            <th>Cost (EGP)</th>
                            <th>Selling Price (EGP)</th>
                            <th>Profit (EGP)</th>
                            <th>Profit Margin</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SaleItems)
                        {
                            <tr>
                                <td><i class="fas fa-hashtag text-primary me-2"></i> @item.SlabNumber</td>
                                <td><i class="fas fa-gem text-info me-2"></i> @item.MarbleTypeName</td>
                                <td><i class="fas fa-ruler-combined text-muted me-1"></i> @item.Width × @item.Length × @item.Thickness cm</td>
                                <td><i class="fas fa-ruler text-success me-1"></i> @item.AreaSold.ToString("N4")</td>
                                <td><i class="fas fa-dollar-sign text-danger me-1"></i> EGP @item.Cost.ToString("N2")</td>
                                <td><i class="fas fa-dollar-sign text-success me-1"></i> EGP @item.SellingPriceEGP.ToString("N2")</td>
                                <td>
                                    <i class="fas @(item.Profit >= 0 ? "fa-arrow-up text-success" : "fa-arrow-down text-danger") me-1"></i>
                                    EGP @item.Profit.ToString("N2")
                                </td>
                                <td>
                                    <span class="badge @(item.ProfitMargin >= 20 ? "bg-success" : 
                                          item.ProfitMargin >= 10 ? "bg-info" : 
                                          item.ProfitMargin >= 5 ? "bg-warning" : "bg-danger")">
                                        @item.ProfitMargin.ToString("N2")%
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="Slabs" asp-action="Details" asp-route-id="@item.SlabId" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye"></i> Slab
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center">
                <i class="fas fa-list fa-3x text-muted mb-2"></i>
                <p class="text-muted">No items associated with this sale.</p>
            </div>
        }
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-tasks me-2"></i>Actions</h5>
    </div>
    <div class="card-body">
        <div class="d-grid gap-2">
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-primary">
                <i class="fas fa-user me-1"></i> View Customer Details
            </a>
            <a asp-controller="Sales" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to Sales List
            </a>
        </div>
    </div>
</div>