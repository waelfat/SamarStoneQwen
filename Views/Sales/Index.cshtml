<!-- Views/Sales/Index.cshtml -->
@model IEnumerable<Sale>
@{
    ViewData["Title"] = "Sales";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-tags me-2"></i>Sales</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <div class="btn-group me-2">
            <a asp-action="Create" class="btn btn-sm btn-outline-success">
                <i class="fas fa-tag me-1"></i> New Sale
            </a>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th><i class="fas fa-user me-1"></i>Customer</th>
                <th><i class="fas fa-calendar me-1"></i>Date</th>
                <th><i class="fas fa-list me-1"></i>Items</th>
                <th><i class="fas fa-dollar-sign me-1"></i>Total (EGP)</th>
                <th><i class="fas fa-chart-line me-1"></i>Profit (EGP)</th>
                <th><i class="fas fa-cogs me-1"></i>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var totalRevenue = item.SaleItems.Sum(si => si.SellingPriceEGP);
                var totalProfit = item.SaleItems.Sum(si => si.SellingPriceEGP - (si.AreaSold * si.CostPerSqM * 15.7m));
                
                <tr>
                    <td><i class="fas fa-user text-primary me-2"></i> @item.Customer.Name</td>
                    <td><i class="fas fa-calendar text-muted me-1"></i> @item.SaleDate.ToString("dd/MM/yyyy")</td>
                    <td><i class="fas fa-list text-info me-1"></i> @item.SaleItems.Count() items</td>
                    <td><i class="fas fa-dollar-sign text-success me-1"></i> EGP @totalRevenue.ToString("N2")</td>
                    <td><i class="fas fa-chart-line text-success me-1"></i> EGP @totalProfit.ToString("N2")</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Details">
                                <i class="fas fa-eye"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>