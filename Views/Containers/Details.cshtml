<!-- Views/Containers/Details.cshtml (Fixed) -->
@model Container
@{
    ViewData["Title"] = "Container Details";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-box me-2"></i>Container Details</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-info-circle me-2"></i>Container Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-4"><strong>Container #:</strong></div>
                    <div class="col-sm-8">@Model.ContainerNumber</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Size:</strong></div>
                    <div class="col-sm-8">@Model.SizeInFeet ft</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Weight:</strong></div>
                    <div class="col-sm-8">
                        @if (Model.WeightInTons > 0)
                        {
                            @($"{Model.WeightInTons} tons")
                        }
                        else
                        {
                            <span class="text-muted">Not specified</span>
                        }
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Status:</strong></div>
                    <div class="col-sm-8">
                        <span class="badge @(Model.Status == "Unloaded" || Model.Status == "Arrived" ? "bg-success" : 
                              Model.Status == "Shipped" ? "bg-info" : "bg-warning")">
                            <i class="fas @(Model.Status == "Unloaded" || Model.Status == "Arrived" ? "fa-check-circle" : 
                                  Model.Status == "Shipped" ? "fa-shipping-fast" : "fa-clock") me-1"></i>
                            @Model.Status
                        </span>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Arrival Date:</strong></div>
                    <div class="col-sm-8">
                        @if (Model.ArrivalDate.HasValue)
                        {
                            @Model.ArrivalDate.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span class="text-muted">Not arrived yet</span>
                        }
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Purchase Order:</strong></div>
                    <div class="col-sm-8">@Model.PurchaseOrder.Supplier.Name</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Supplier:</strong></div>
                    <div class="col-sm-8">@Model.PurchaseOrder.Supplier.Name</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Notes:</strong></div>
                    <div class="col-sm-8">@Model.Notes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-tasks me-2"></i>Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-action="UploadSlabFile"  asp-route-id="@Model.Id" class="btn btn-primary mb-2">
                        <i class="fas fa-file-import me-1"></i> Upload Slab File
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info mb-2">
                        <i class="fas fa-edit me-1"></i> Edit Container
                    </a>
                    <a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@Model.PurchaseOrderId" class="btn btn-secondary mb-2">
                        <i class="fas fa-file-invoice me-1"></i> View Purchase Order
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-th-large me-2"></i>Slabs in this Container</h5>
    </div>
    <div class="card-body">
        @if (Model.Slabs.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Slab #</th>
                            <th>Type</th>
                            <th>Dimensions</th>
                            <th>Area (sqm)</th>
                            <th>Quality</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slab in Model.Slabs)
                        {
                            <tr>
                                <td>@slab.SlabNumber</td>
                                <td>@slab.MarbleTypeNavigation.Name</td>
                                <td>@slab.Width × @slab.Length × @slab.Thickness cm</td>
                                <td>@slab.Area.ToString("N4")</td>
                                <td><span class="badge bg-info">@slab.MarbleTypeNavigation.QualityGrade</span></td>
                                <td>
                                    <span class="badge @(slab.Status == "Available" ? "bg-success" : 
                                          slab.Status == "Sold" ? "bg-danger" : "bg-warning")">
                                        @slab.Status
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="Slabs" asp-action="Details" asp-route-id="@slab.Id" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center">
                <i class="fas fa-th-large fa-3x text-muted mb-2"></i>
                <p class="text-muted">No slabs have been imported for this container yet.</p>
                <p class="text-muted small">Upload the supplier's Excel file to import slab details.</p>
            </div>
        }
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-chart-pie me-2"></i>Container Statistics</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="text-center">
                    <h4 class="text-primary">@Model.Slabs.Count()</h4>
                    <p class="text-muted">Total Slabs</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="text-center">
                    <h4 class="text-success">@(Model.Slabs.Count(s => s.Status == "Available"))</h4>
                    <p class="text-muted">Available Slabs</p>
                </div>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-12">
                <div class="progress mb-2" style="height: 20px;">
                    <div class="progress-bar bg-success" role="progressbar" 
                         style="width: @(Model.Slabs.Any() ? (decimal)Model.Slabs.Count(s => s.Status == "Available") / Model.Slabs.Count() * 100 : 0)%" 
                         aria-valuenow="@(Model.Slabs.Any() ? (decimal)Model.Slabs.Count(s => s.Status == "Available") / Model.Slabs.Count() * 100 : 0)" 
                         aria-valuemin="0" aria-valuemax="100">
                        @(Model.Slabs.Any() ? Math.Round((decimal)Model.Slabs.Count(s => s.Status == "Available") / Model.Slabs.Count() * 100, 2) : 0)%
                    </div>
                </div>
                <small class="text-muted">Availability Rate</small>
            </div>
        </div>
    </div>
</div>