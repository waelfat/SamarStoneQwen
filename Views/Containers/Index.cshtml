<!-- Views/Containers/Index.cshtml -->
@model IEnumerable<Container>
@{
    ViewData["Title"] = "Containers";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-boxes me-2"></i>Containers</h1>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" class="form-control" placeholder="Search containers..." id="searchInput">
        </div>
    </div>
    <div class="col-md-6 text-end">
        <a asp-controller="PurchaseOrders" asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i> New Purchase Order
        </a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th><i class="fas fa-hashtag me-1"></i>Container #</th>
                <th><i class="fas fa-ruler-combined me-1"></i>Size (ft)</th>
                <th><i class="fas fa-weight-hanging me-1"></i>Weight (tons)</th>
                <th><i class="fas fa-flag me-1"></i>Status</th>
                <th><i class="fas fa-calendar me-1"></i>Arrival Date</th>
                <th><i class="fas fa-cogs me-1"></i>Actions</th>
            </tr>
        </thead>
        <tbody id="containersTable">
            @foreach (var item in Model)
            {
                <tr>
                    <td><i class="fas fa-box text-primary me-2"></i> @item.ContainerNumber</td>
                    <td><i class="fas fa-ruler-combined text-info me-1"></i> @item.SizeInFeet ft</td>
                    <td><i class="fas fa-weight-hanging text-success me-1"></i> @item.WeightInTons tons</td>
                    <td>
                        <span class="badge @(item.Status == "Delivered" || item.Status == "Unloaded" ? "bg-success" : 
                              item.Status == "Arrived" ? "bg-warning" : "bg-info")">
                            <i class="fas @(item.Status == "Delivered" || item.Status == "Unloaded" ? "fa-check-circle" : 
                                  item.Status == "Arrived" ? "fa-truck-loading" : "fa-shipping-fast") me-1"></i>
                            @item.Status
                        </span>
                    </td>
                    <td>
                        @if (item.ArrivalDate.HasValue)
                        {
                            <i class="fas fa-calendar-check text-success me-1"></i>
                            @item.ArrivalDate.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <i class="fas fa-clock text-muted me-1"></i>
                            <span class="text-muted">Not arrived</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Details" asp-route-Id="@item.Id" class="btn btn-outline-info" title="Details">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="UploadSlabFile"  asp-route-Id="@item.Id" class="btn btn-outline-primary" title="Upload Slabs">
                                <i class="fas fa-file-import"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.getElementById('searchInput').addEventListener('keyup', function() {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('#containersTable tr');
        
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(searchTerm) ? '' : 'none';
        });
    });
</script>