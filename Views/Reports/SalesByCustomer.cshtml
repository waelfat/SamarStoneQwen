@using SamarStoneQwen.Controllers
<!-- Views/Reports/SalesByCustomer.cshtml -->
@model IEnumerable<SalesByCustomerReportItem>
@{
    ViewData["Title"] = "Sales by Customer";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-chart-pie me-2"></i>Sales by Customer</h1>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th><i class="fas fa-user me-1"></i>Customer</th>
                <th><i class="fas fa-shopping-cart me-1"></i>Total Sales</th>
                <th><i class="fas fa-receipt me-1"></i>Total Revenue (EGP)</th>
                <th><i class="fas fa-chart-line me-1"></i>Total Profit (EGP)</th>
                <th><i class="fas fa-percentage me-1"></i>Profit Margin (%)</th>
                <th><i class="fas fa-star me-1"></i>Customer Rank</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderByDescending(m => m.TotalRevenue))
            {
                <tr>
                    <td><i class="fas fa-user text-primary me-2"></i> <strong>@item.CustomerName</strong></td>
                    <td><i class="fas fa-shopping-cart text-info me-1"></i> @item.TotalSales</td>
                    <td><i class="fas fa-receipt text-success me-1"></i> EGP @item.TotalRevenue.ToString("N2")</td>
                    <td><i class="fas fa-chart-line text-success me-1"></i> EGP @item.TotalProfit.ToString("N2")</td>
                    <td>
                        <span class="badge @(item.TotalRevenue > 0 ? 
                              (item.TotalProfit / item.TotalRevenue * 100 >= 20 ? "bg-success" : 
                               item.TotalProfit / item.TotalRevenue * 100 >= 10 ? "bg-info" : 
                               item.TotalProfit / item.TotalRevenue * 100 >= 5 ? "bg-warning" : "bg-danger") : 
                              "bg-secondary")">
                            @if (item.TotalRevenue > 0)
                            {
                                @(Math.Round(item.TotalProfit / item.TotalRevenue * 100, 2).ToString("N2") + "%")
                            }
                            else
                            {
                                @:0%
                            }
                        </span>
                    </td>
                    <td>
                        <span class="badge bg-primary">
                            @(Model.OrderByDescending(m => m.TotalRevenue).ToList().IndexOf(item) + 1)
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="row mt-4">
    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-users me-2"></i>Top 5 Customers</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Customer</th>
                                <th>Revenue (EGP)</th>
                                <th>Share (%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var top5 = Model.OrderByDescending(m => m.TotalRevenue).Take(5).ToList();
                                var totalRevenue = Model.Sum(m => m.TotalRevenue);
                            }
                            @for (int i = 0; i < top5.Count; i++)
                            {
                                <tr>
                                    <td><span class="badge bg-primary">@(i + 1)</span></td>
                                    <td><strong>@top5[i].CustomerName</strong></td>
                                    <td>EGP @top5[i].TotalRevenue.ToString("N2")</td>
                                    <td>
                                        @if (totalRevenue > 0)
                                        {
                                            <span>@Math.Round(top5[i].TotalRevenue / totalRevenue * 100, 2)%</span>
                                        }
                                        else
                                        {
                                            <span>0%</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-chart-pie me-2"></i>Revenue Distribution</h6>
            </div>
            <div class="card-body">
                <div class="chart-pie pt-4">
                    <canvas id="revenueDistributionChart"></canvas>
                </div>
                <div class="mt-4 text-center small">
                    <span class="mr-2">
                        <i class="fas fa-circle text-success"></i> Top 3 Customers
                    </span>
                    <span class="mr-2">
                        <i class="fas fa-circle text-info"></i> Others
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Revenue distribution chart
        const revenueCtx = document.getElementById('revenueDistributionChart').getContext('2d');
        
        // Prepare data for top 3 vs others
        const orderedItems = @Html.Raw(Json.Serialize(Model.OrderByDescending(m => m.TotalRevenue).ToList()));
        const top3Total = orderedItems.slice(0, 3).reduce((sum, item) => sum + item.totalRevenue, 0);
        const othersTotal = orderedItems.slice(3).reduce((sum, item) => sum + item.totalRevenue, 0);
        
        new Chart(revenueCtx, {
            type: 'doughnut',
            data: {
                labels: ['Top 3 Customers', 'Others'],
                datasets: [{
                    data: [top3Total, othersTotal],
                    backgroundColor: [
                        'rgba(40, 167, 69, 0.8)',
                        'rgba(23, 162, 184, 0.8)'
                    ],
                    borderColor: [
                        'rgba(40, 167, 69, 1)',
                        'rgba(23, 162, 184, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    });
</script>