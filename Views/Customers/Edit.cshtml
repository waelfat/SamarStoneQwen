<!-- Views/Customers/Edit.cshtml -->
@model EditCustomerViewModel
@{
    ViewData["Title"] = "Edit Customer";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-user-edit me-2"></i>Edit Customer</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-user me-2"></i>Customer Information</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Name" class="form-label"><i class="fas fa-user me-1"></i>Name</label>
                                <input asp-for="Name" class="form-control" placeholder="Enter customer name" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Email" class="form-label"><i class="fas fa-envelope me-1"></i>Email</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Phone" class="form-label"><i class="fas fa-phone me-1"></i>Phone</label>
                                <input asp-for="Phone" class="form-control" placeholder="Enter phone number" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="TaxNumber" class="form-label"><i class="fas fa-id-card me-1"></i>Tax Number</label>
                                <input asp-for="TaxNumber" class="form-control" placeholder="Enter tax number" />
                                <span asp-validation-for="TaxNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Address" class="form-label"><i class="fas fa-home me-1"></i>Address</label>
                        <input asp-for="Address" class="form-control" placeholder="Enter street address" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="City" class="form-label"><i class="fas fa-city me-1"></i>City</label>
                                <input asp-for="City" class="form-control" placeholder="Enter city" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Country" class="form-label"><i class="fas fa-flag me-1"></i>Country</label>
                                <input asp-for="Country" class="form-control" placeholder="Enter country" />
                                <span asp-validation-for="Country" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Notes" class="form-label"><i class="fas fa-sticky-note me-1"></i>Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Additional notes about the customer"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox">
                            <label asp-for="IsActive" class="form-check-label">Active Customer</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Update Customer
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-info-circle me-2"></i>Customer Information</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <strong>Customer ID:</strong> <code>@Model.Id.Substring(0, 8)...</code>
                </div>
                <div class="mb-3">
                    <strong>Customer Name:</strong> @Model.Name
                </div>
                <div class="mb-3">
                    <strong>Email:</strong> @Model.Email
                </div>
                <div class="mb-3">
                    <strong>Phone:</strong> @Model.Phone
                </div>
                <div class="mb-3">
                    <strong>Status:</strong> 
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
                <div class="alert alert-info">
                    <h6><i class="fas fa-user-check me-2"></i>Customer Status</h6>
                    <p class="mb-0">Active customers can be selected in sales orders. Inactive customers won't appear in selection lists.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}