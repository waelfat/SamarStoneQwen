<!-- Views/Customers/Index.cshtml -->
@model IEnumerable<Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-users me-2"></i>Customers</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <div class="btn-group me-2">
            <a asp-action="Create" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-user-plus me-1"></i> New Customer
            </a>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" class="form-control" placeholder="Search customers..." id="searchInput">
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th><i class="fas fa-user me-1"></i>Name</th>
                <th><i class="fas fa-envelope me-1"></i>Email</th>
                <th><i class="fas fa-phone me-1"></i>Phone</th>
                <th><i class="fas fa-map-marker-alt me-1"></i>City</th>
                <th><i class="fas fa-flag me-1"></i>Country</th>
                <th><i class="fas fa-toggle-on me-1"></i>Status</th>
                <th><i class="fas fa-cogs me-1"></i>Actions</th>
            </tr>
        </thead>
        <tbody id="customersTable">
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <i class="fas fa-user-circle me-2 text-primary"></i>
                        <strong>@item.Name</strong>
                    </td>
                    <td><i class="fas fa-envelope text-muted me-1"></i> @item.Email</td>
                    <td><i class="fas fa-phone text-muted me-1"></i> @item.Phone</td>
                    <td><i class="fas fa-map-marker-alt text-muted me-1"></i> @item.City</td>
                    <td><i class="fas fa-flag text-muted me-1"></i> @item.Country</td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                            <i class="fas @(item.IsActive ? "fa-check-circle" : "fa-times-circle") me-1"></i>
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Details">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.getElementById('searchInput').addEventListener('keyup', function() {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('#customersTable tr');
        
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(searchTerm) ? '' : 'none';
        });
    });
</script>