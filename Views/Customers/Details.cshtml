<!-- Views/Customers/Details.cshtml -->
@model Customer
@{
    ViewData["Title"] = "Customer Details";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-user me-2"></i>Customer Details</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-info-circle me-2"></i>Customer Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-4"><strong>Customer Name:</strong></div>
                    <div class="col-sm-8"><i class="fas fa-user text-primary me-2"></i> <strong>@Model.Name</strong></div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Email:</strong></div>
                    <div class="col-sm-8"><i class="fas fa-envelope text-muted me-2"></i> @Model.Email</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Phone:</strong></div>
                    <div class="col-sm-8"><i class="fas fa-phone text-muted me-2"></i> @Model.Phone</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Tax Number:</strong></div>
                    <div class="col-sm-8"><i class="fas fa-id-card text-info me-2"></i> @Model.TaxNumber</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Address:</strong></div>
                    <div class="col-sm-8"><i class="fas fa-home text-success me-2"></i> @Model.Address</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>City:</strong></div>
                    <div class="col-sm-8"><i class="fas fa-city text-info me-2"></i> @Model.City</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Country:</strong></div>
                    <div class="col-sm-8"><i class="fas fa-flag text-primary me-2"></i> @Model.Country</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Status:</strong></div>
                    <div class="col-sm-8">
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                            <i class="fas @(Model.IsActive ? "fa-check-circle" : "fa-times-circle") me-1"></i>
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Created Date:</strong></div>
                    <div class="col-sm-8"><i class="fas fa-calendar text-muted me-2"></i> @Model.CreatedDate.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-4"><strong>Notes:</strong></div>
                    <div class="col-sm-8"><i class="fas fa-sticky-note text-muted me-2"></i> @Model.Notes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-tasks me-2"></i>Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="fas fa-edit me-1"></i> Edit Customer
                    </a>
                    @if (Model.IsActive)
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i> Deactivate Customer
                        </a>
                    }
                    else
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">
                            <i class="fas fa-check-circle me-1"></i> Reactivate Customer
                        </a>
                    }
                    <a asp-controller="Sales" asp-action="Create"  asp-route-id="@Model.Id" class="btn btn-info">
                        <i class="fas fa-tag me-1"></i> Create Sale
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header">
                <h5><i class="fas fa-chart-bar me-2"></i>Customer Summary</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <strong>Total Sales:</strong> 
                    <span class="badge bg-info">@Model.Sales.Count()</span>
                </div>
                @{
                    var totalRevenue = Model.Sales.Sum(s => s.SaleItems.Sum(si => si.SellingPriceEGP));
                    var totalProfit = Model.Sales.Sum(s => s.SaleItems.Sum(si => si.SellingPriceEGP - (si.AreaSold * si.CostPerSqM * 15.7m)));
                }
                <div class="mb-2">
                    <div class="d-flex justify-content-between">
                        <span>Total Revenue:</span>
                        <strong class="text-success">EGP @totalRevenue.ToString("N2")</strong>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <span>Total Profit:</span>
                        <strong class="text-success">EGP @totalProfit.ToString("N2")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-shopping-cart me-2"></i>Customer Sales</h5>
    </div>
    <div class="card-body">
        @if (Model.Sales.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Sale #</th>
                            <th>Sale Date</th>
                            <th>Items Count</th>
                            <th>Total Revenue (EGP)</th>
                            <th>Total Profit (EGP)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sale in Model.Sales.OrderByDescending(s => s.SaleDate))
                        {
                            var saleRevenue = sale.SaleItems.Sum(si => si.SellingPriceEGP);
                            var saleProfit = sale.SaleItems.Sum(si => si.SellingPriceEGP - (si.AreaSold * si.CostPerSqM * 15.7m));
                            
                            <tr>
                                <td><code>@sale.Id.Substring(0, 8)...</code></td>
                                <td>@sale.SaleDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-info">@sale.SaleItems.Count()</span></td>
                                <td><strong class="text-success">EGP @saleRevenue.ToString("N2")</strong></td>
                                <td><strong class="text-success">EGP @saleProfit.ToString("N2")</strong></td>
                                <td>
                                    <a asp-controller="Sales" asp-action="Details" asp-route-id="@sale.Id" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center">
                <i class="fas fa-shopping-cart fa-3x text-muted mb-2"></i>
                <p class="text-muted">No sales associated with this customer yet.</p>
                <a asp-controller="Sales" asp-action="Create"  asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i> Create First Sale
                </a>
            </div>
        }
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-chart-line me-2"></i>Sales Performance</h5>
    </div>
    <div class="card-body">
        @if (Model.Sales.Any())
        {
            <div class="row">
                <div class="col-md-4 text-center">
                    <h3 class="text-primary">@Model.Sales.Count()</h3>
                    <p class="text-muted">Total Sales</p>
                </div>
                <div class="col-md-4 text-center">
                    <h3 class="text-success">EGP @totalRevenue.ToString("N2")</h3>
                    <p class="text-muted">Total Revenue</p>
                </div>
                <div class="col-md-4 text-center">
                    <h3 class="text-success">EGP @totalProfit.ToString("N2")</h3>
                    <p class="text-muted">Total Profit</p>
                </div>
            </div>
            
            @if (Model.Sales.Count() > 1)
            {
                <div class="progress mt-3" style="height: 10px;">
                    @{
                        var avgProfit = totalRevenue > 0 ? (totalProfit / totalRevenue * 100) : 0;
                    }
                    <div class="progress-bar bg-success" role="progressbar" 
                         style="width: @(Math.Abs(avgProfit).ToString("N2"))%" 
                         aria-valuenow="@(Math.Abs(avgProfit))" 
                         aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
                <small class="text-muted">Average Profit Margin: @avgProfit.ToString("N2")%</small>
            }
        }
        else
        {
            <div class="text-center">
                <i class="fas fa-chart-line fa-3x text-muted mb-2"></i>
                <p class="text-muted">No sales data available for this customer.</p>
            </div>
        }
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-tasks me-2"></i>Customer Actions</h5>
    </div>
    <div class="card-body">
        <div class="d-grid gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit me-1"></i> Edit Customer Information
            </a>
            @if (Model.IsActive)
            {
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                    <i class="fas fa-user-slash me-1"></i> Deactivate Customer
                </a>
            }
            else
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-success">
                    <i class="fas fa-user-check me-1"></i> Reactivate Customer
                </a>
            }
            <a asp-controller="Sales" asp-action="Create"  asp-route-id="@Model.Id" class="btn btn-info">
                <i class="fas fa-shopping-cart me-1"></i> Create New Sale
            </a>
        </div>
    </div>
</div>